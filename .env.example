# Copy to `.env` for local dev and fill in. NEVER commit a real .env.
# In production these come from Azure Key Vault / Function app settings, not a file.

# --- Zoho Desk API (PLACEHOLDER - fill in when you have API access) ---
# Pick the domains for your data-centre region (US .com / EU .eu / IN .in / AU .com.au).
ZOHO_DESK_BASE_URL=https://desk.zoho.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ORG_ID=PLACEHOLDER_ORG_ID
ZOHO_CLIENT_ID=PLACEHOLDER_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=PLACEHOLDER_ZOHO_CLIENT_SECRET
# Long-lived refresh token minted once (self-client / authorised grant) with Desk scopes
# such as Desk.tickets.READ, Desk.tickets.UPDATE, Desk.tickets.CREATE (for comments).
ZOHO_REFRESH_TOKEN=PLACEHOLDER_REFRESH_TOKEN

# --- Webhook front door ---
# Shared secret token the Desk workflow/webhook rule sends on every call (custom header),
# verified before any work. In production, store this in Key Vault (resolved via
# lib/secrets.py) rather than here.
ZOHO_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET
# Optional replay protection (seconds). If >0 AND the Desk workflow sends a timestamp
# header, requests whose timestamp is older/newer than this skew are rejected. Leave
# 0/unset to disable.
# ZOHO_WEBHOOK_MAX_SKEW=300

# --- Microsoft Graph / Azure (Phase B - placeholders for now) ---
# Per-client tenant credentials are looked up by client config; these are defaults/dev.
AZURE_TENANT_ID=PLACEHOLDER_TENANT_ID
AZURE_CLIENT_ID=PLACEHOLDER_GRAPH_APP_ID
AZURE_CLIENT_SECRET=PLACEHOLDER_GRAPH_APP_SECRET

# --- Secrets store (optional; env wins, then Key Vault) ---
# KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net/

# --- Durable idempotency state (prod uses Azure Table; dev falls back to a file) ---
# STATE_TABLE_CONNECTION_STRING=PLACEHOLDER_TABLE_CONN_STRING
# STATE_TABLE_NAME=agentstate
STATE_PATH=./state.json

# --- Operator alerting for failed / needs-attention (Teams/Slack incoming webhook) ---
# NOTIFY_WEBHOOK_URL=https://outlook.office.com/webhook/...

# --- Behaviour ---
APPROVAL_REQUIRED=true
AUDIT_LOG_PATH=./audit.log
